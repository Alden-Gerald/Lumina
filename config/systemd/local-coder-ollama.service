[Unit]
Description=Local Coder RX 6600 builder with CPU offload
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Slice=local-coder-inference.slice
ExecStart=/home/gerald/local-coder/.venv/bin/python -m local_coder.gpu_policy launch
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/home/gerald/.local/share/local-coder/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_QUEUE=2
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_CONTEXT_LENGTH=8192
Environment=OLLAMA_KEEP_ALIVE=30s
Environment=OLLAMA_VULKAN=1
Environment=OLLAMA_GPU_OVERHEAD=1073741824
MemoryAccounting=yes
MemoryHigh=14G
MemoryMax=16G
MemorySwapMax=0
TasksMax=128
CPUWeight=20
CPUQuota=800%
OOMPolicy=stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
